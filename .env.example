# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- כניסה לממשק (שם משתמש וסיסמה קבועים) ---
APP_USERNAME=admin
APP_PASSWORD=change-me

# מפתח לחתימת עוגיות ההתחברות. ליצירה:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true כשהאתר מוגש ב-HTTPS (מומלץ בשרת)
COOKIE_SECURE=false

# --- אופציונלי ---
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high
MAX_CONCURRENCY=4
SESSION_DAYS=30
PORT=8000
