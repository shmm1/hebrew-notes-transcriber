# --- מנועי זיהוי: מספיק אחד. אם מוגדרים שניים, אפשר לבחור ביניהם בממשק ---

# Gemini: מפתח חינמי מ-https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-flash-latest הוא כינוי של Google לגרסת ה-Flash החדשה ביותר
GEMINI_MODEL=gemini-flash-latest

# Claude: מפתח מ-https://console.anthropic.com
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=high

# המנוע שנבחר כברירת מחדל כשמוגדרים שניהם: gemini או claude
DEFAULT_PROVIDER=gemini

# --- כניסה לממשק (שם משתמש וסיסמה קבועים) ---
APP_USERNAME=admin
APP_PASSWORD=change-me

# מפתח לחתימת עוגיות ההתחברות. ליצירה: openssl rand -hex 32
SECRET_KEY=

# true כשהאתר מוגש ב-HTTPS (מומלץ בשרת)
COOKIE_SECURE=false

# --- אופציונלי ---
MAX_CONCURRENCY=4
SESSION_DAYS=30
PORT=8000
